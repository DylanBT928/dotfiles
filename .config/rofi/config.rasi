* {
    font: "FiraCode Nerd Font 12";
    surface: #1a1a1ae6;
    surface-container-highest: #262626;
    primary: #3a3a3a;
    on-surface: #e0e0e0;
    on-surface-variant: #a4ada9;
    on-primary: #ffffff;
}

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: " ";
    drun-display-format: "{name}";
}

window {
    width: 600px;
    height: 425px;
    transparency: "real";
    background-color: @surface;
    border: 1px solid;
    border-color: #3a3a3a;
    border-radius: 8px;
}

mainbox {
    padding: 20px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    margin: 0px 0px 15px 0px;
    padding: 10px 14px;
    background-color: @surface-container-highest;
    border-radius: 6px;
    children: [ prompt, entry ];
}

prompt {
    margin: 0px 10px 0px 0px;
    background-color: transparent;
    text-color: @on-surface-variant;
}

entry {
    font: "FiraCode Nerd Font 12";
    placeholder: "search...";
    placeholder-color: @on-surface-variant;
    background-color: transparent;
    text-color: @on-surface;
}

listview {
    columns: 1;
    lines: 6;
    spacing: 6px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    border: 0px;
    background-color: transparent;
}

element {
    padding: 8px 12px;
    border-radius: 6px;
    cursor: pointer;
    background-color: transparent;
    children: [ element-icon, element-text ];
}

element-icon {
    size: 28px;
    margin: 0px 10px 0px 0px;
    background-color: transparent;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @on-surface;
}

element selected.normal {
    background-color: @primary;
    text-color: @on-primary;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
