{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "battery"
    ],
    "clock": {
        "format": "{:%A %b %d | %I:%M:%S %p}",
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 4,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        }
    },
    "cpu": {
        "format": "CPU: {usage}%",
        "interval": 10,
        "tooltip": true
    },
    "memory": {
        "format": "RAM: {used:0.1f}GiB",
        "interval": 10,
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB"
    },
    "network": {
        "format-wifi": "NET: {signalStrength}%",
        "format-ethernet": "NET: {ipaddr}",
        "format-disconnected": "DISCONNECTED",
        "interval": 10,
        "tooltip": false
    },
    "pulseaudio": {
        "format": "VOL: {volume}%",
        "format-muted": "MUTE",
        "on-click": "pavucontrol",
        "tooltip": false
    },
    "battery": {
        "format": "BAT: {capacity}%",
        "interval": 10,
        "states": {
            "critical": 20
        }
    }
}
